{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delaware-data-commons.example/schemas/prompt-guides.schema.json",
  "title": "Delaware Data Commons prompt guide catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "purpose", "shared_rules", "review_levels", "guides"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "updated_at": { "type": "string", "format": "date" },
    "purpose": { "type": "string", "minLength": 1 },
    "shared_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "review_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "recommended"],
      "properties": {
        "required": { "$ref": "#/$defs/reviewLevel" },
        "recommended": { "$ref": "#/$defs/reviewLevel" }
      }
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/guide" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "community_explanation", "technical_explanation"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "community_explanation": { "type": "string", "minLength": 1 },
        "technical_explanation": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "placeholder"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string", "pattern": "^\\[.+\\]$" }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "why", "checkpoints"],
      "properties": {
        "level": { "enum": ["required", "recommended"] },
        "why": { "type": "string", "minLength": 1 },
        "checkpoints": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "last_reviewed", "reviewer_role"],
      "properties": {
        "basis": { "type": "string", "minLength": 1 },
        "last_reviewed": { "type": "string", "format": "date" },
        "reviewer_role": { "type": "string", "minLength": 1 }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "title",
        "category",
        "category_label",
        "task",
        "community_summary",
        "technical_notes",
        "when_to_use",
        "required_inputs",
        "instructions",
        "output_sections",
        "human_review",
        "related_routes",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "enum": ["pilot", "reviewed", "retired"] },
        "title": { "type": "string", "minLength": 1 },
        "category": { "enum": ["find-understand", "compare-combine", "communicate", "check-document"] },
        "category_label": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "community_summary": { "type": "string", "minLength": 1 },
        "technical_notes": { "type": "string", "minLength": 1 },
        "when_to_use": { "type": "string", "minLength": 1 },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/input" }
        },
        "instructions": { "$ref": "#/$defs/nonEmptyStrings" },
        "output_sections": { "$ref": "#/$defs/nonEmptyStrings" },
        "human_review": { "$ref": "#/$defs/humanReview" },
        "related_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
