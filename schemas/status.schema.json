{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delaware-public-data-catalog:schema:status:1.0.0",
  "title": "Delaware Public Data Monitor Scan",
  "description": "Append-only observation output. It reports what the monitor observed and never changes curator-controlled dataset lifecycle.",
  "type": "object",
  "required": [
    "schema_version",
    "scan_id",
    "started_at",
    "completed_at",
    "monitor_version",
    "deep",
    "policy",
    "summary",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scan_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "monitor_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "deep": {
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 120
    },
    "sanitized_uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "description": "A URL without user information, query, or fragment."
    },
    "access_status": {
      "enum": [
        "available",
        "degraded",
        "unavailable",
        "blocked",
        "rate-limited",
        "invalid-target",
        "error"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "allowed_schemes",
        "timeout_seconds",
        "max_bytes",
        "max_redirects",
        "retries"
      ],
      "properties": {
        "allowed_schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "https",
              "http"
            ]
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "available",
        "degraded",
        "unavailable",
        "blocked",
        "rate_limited",
        "invalid_target",
        "error"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "rate_limited": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_target": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "dataset_id",
        "distribution_id",
        "observed_at",
        "requested_url",
        "access_status",
        "reason",
        "redirect_chain",
        "bytes_sampled",
        "sample_complete",
        "retry_count"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/stable_id"
        },
        "distribution_id": {
          "$ref": "#/$defs/stable_id"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "requested_url": {
          "$ref": "#/$defs/sanitized_uri"
        },
        "final_url": {
          "$ref": "#/$defs/sanitized_uri"
        },
        "redirect_chain": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/sanitized_uri"
          }
        },
        "access_status": {
          "$ref": "#/$defs/access_status"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": "string",
          "maxLength": 255
        },
        "content_length": {
          "type": "integer",
          "minimum": 0
        },
        "etag": {
          "type": "string",
          "maxLength": 500
        },
        "last_modified": {
          "type": "string",
          "maxLength": 200
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_sampled": {
          "type": "integer",
          "minimum": 0
        },
        "sample_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sample_complete": {
          "type": "boolean"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "error_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 100
        },
        "error_message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  }
}
